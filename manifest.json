{
  "manifest_version": 3,
  "name": "Kode24 Ad Blocker",
  "version": "1.0",
  "description": "Removes ads, banners, job listings, and commercial clutter from kode24.no",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://www.kode24.no/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
